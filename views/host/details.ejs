
    <link rel="stylesheet" href="/Details.css">
    <%- include('../partials/head') %>
</head>
<body>
 <%- include('../Partials/nav') %>
<form action="/addHome" method="POST" class="home-form">

    <!-- HOME NAME -->
    <label for="homeName">Home Name:</label>

    <input
        type="text"
        id="homeName"
        name="homeName"
        placeholder="Enter home name"
        required
    >

    <!-- PRICE -->
    <label for="price">Price:</label>

    <input
        type="number"
        id="price"
        name="price"
        placeholder="Enter price"
        required
    >

    <!-- CITY -->
    <label for="city">City:</label>

    <input
        type="text"
        id="city"
        name="city"
        placeholder="Enter city"
        required
    >

    <!-- NUMBER OF ROOMS -->
    <label for="rooms">Number of Rooms:</label>

    <input
        type="number"
        id="rooms"
        name="rooms"
        placeholder="Enter number of rooms"
        required
    >

    <!-- IMAGE LINK -->
    <label for="image">Home Image Link:</label>

    <input
        type="url"
        id="image"
        name="image"
        placeholder="Paste image URL"
        required
    >
    <!-- RATING -->
    <label for="rating">Rating:</label>

    <input
    type="number"
    id="rating"
    name="rating"
    placeholder="Enter rating (1 to 5)"
    min="1"
    max="5"
    step="0.1"
    required
    >

    <!-- SUBMIT BUTTON -->
    <button type="submit">
        Add Home
    </button>

</form>
 <%- include('../Partials/footer') %>
</body>
</html>