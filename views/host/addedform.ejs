<style>
    .success-container {
    min-height: calc(100vh - 120px); /* nav + footer safe */
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #667eea, #764ba2);
    padding: 20px;
}

/* CARD */
.success-card {
    background: rgba(255, 255, 255, 0.95);
    padding: 40px 30px;
    border-radius: 18px;
    text-align: center;
    max-width: 420px;
    width: 100%;
    box-shadow: 0 20px 40px rgba(0,0,0,0.25);
    backdrop-filter: blur(12px);
    animation: popIn 0.4s ease;
    transition: all 0.3s ease;
}

/* HOVER EFFECT */
.success-card:hover {
    transform: translateY(-5px);
}

/* TEXT */
.success-card h1 {
    font-size: 22px;
    color: #333;
    font-weight: 700;
    margin-bottom: 20px;
    line-height: 1.4;
}

/* BUTTON */
.back-home-btn {
    display: inline-block;
    padding: 11px 20px;
    background: linear-gradient(135deg, #4f46e5, #6366f1);
    color: white;
    font-weight: 600;
    text-decoration: none;
    border-radius: 12px;
    transition: all 0.3s ease;
}

/* BUTTON HOVER */
.back-home-btn:hover {
    transform: translateY(-3px);
    opacity: 0.9;
}

/* ANIMATION */
@keyframes popIn {
    from {
        transform: scale(0.85);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}
</style>

<%- include('../partials/head') %>

</head>
<body>

<%- include('../partials/nav') %>

<div class="success-container">

    <div class="success-card">

        <h1>🏠 House Name Added Successfully</h1>

        <a href="/home-list" class="back-home-btn">
            Back to Home Page
        </a>

    </div>

</div>

<%- include('../partials/footer') %>

</body>
</html>