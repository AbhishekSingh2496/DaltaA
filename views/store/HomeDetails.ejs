<style>
/* PAGE */
body{
    margin:0;
    padding:0;
    font-family: Arial, Helvetica, sans-serif;
    background: linear-gradient(135deg, #667eea, #764ba2);
}

/* WRAPPER */
.details-wrapper{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:40px 20px;
}

/* CARD */
.home-card{
    width:100%;
    max-width:850px;
    background:#fff;
    border-radius:20px;
    overflow:hidden;
    display:grid;
    grid-template-columns:1fr 1fr;
    box-shadow:0 15px 35px rgba(0,0,0,0.2);
    animation:popIn .4s ease;
}

/* IMAGE */
.home-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

/* CONTENT */
.home-content{
    padding:35px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.home-content h1{
    font-size:32px;
    color:#222;
    margin-bottom:20px;
}

.home-content p{
    font-size:16px;
    color:#555;
    margin-bottom:14px;
    line-height:1.5;
}

/* BADGE */
.home-badge{
    display:inline-block;
    width:fit-content;
    margin-top:10px;
    background:#dcfce7;
    color:#166534;
    padding:6px 14px;
    border-radius:30px;
    font-size:13px;
    font-weight:600;
}

/* BUTTONS */
.home-actions{
    display:flex;
    gap:12px;
    margin-top:25px;
}

.btn{
    text-decoration:none;
    padding:12px 20px;
    border-radius:12px;
    font-size:14px;
    font-weight:600;
    transition:.3s ease;
    text-align:center;
}

/* PRIMARY */
.btn-primary{
    background:linear-gradient(135deg,#4f46e5,#6366f1);
    color:#fff;
}

/* SECONDARY */
.btn-secondary{
    background:#f3f4f6;
    color:#222;
}

.btn:hover{
    transform:translateY(-3px);
}

/* RATING */
.home-rating{
    color:#f59e0b;
    font-weight:600;
}

/* RESPONSIVE */
@media(max-width:768px){

    .home-card{
        grid-template-columns:1fr;
    }

    .home-image img{
        height:300px;
    }

    .home-content{
        padding:25px;
    }

    .home-content h1{
        font-size:26px;
    }

    .home-actions{
        flex-direction:column;
    }
}

/* ANIMATION */
@keyframes popIn{
    from{
        transform:scale(.85);
        opacity:0;
    }
    to{
        transform:scale(1);
        opacity:1;
    }
}
</style>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/nav') %>
<div class="details-wrapper">
    <div class="home-card">
        <!-- IMAGE -->
        <div class="home-image">
            <img src="<%= home.image %>" alt="Home Image">
        </div>
        <!-- CONTENT -->
        <div class="home-content">
            <h1><%= home.homeName %></h1>
            <p>
                📍 <strong>City:</strong> <%= home.city %>
            </p>
            <p>
                💰 <strong>Price:</strong> ₹ <%= home.price %>
            </p>
            <p>
                🛏️ <strong>Rooms:</strong> <%= home.rooms %>
            </p>
            <p class="home-rating">
                ⭐ <%= home.rating %> / 5
            </p>
            <span class="home-badge">
                Active
            </span>
            <div style="margin-top:5px;">
                <%- include('../Partials/favorites') %>
            </div>
            <!-- BUTTONS -->
            <div class="home-actions">
                <a href="/home-list" class="btn btn-secondary">
                    Back
                </a>
                <a href="/Booking" class="btn btn-primary">
                    Book Now
                </a>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
</body>
</html>